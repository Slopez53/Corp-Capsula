{
  "expo": {
    "name": "Cápsula",
    "slug": "capsula-mood",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "backgroundColor": "#F5F4F0",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.capsula.mood"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F4F0"
      },
      "package": "com.capsula.mood"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-haptics"
    ]
  }
}
